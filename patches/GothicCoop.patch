+// SPDX-License-Identifier: AGPL-3.0-or-later
+// Experimental host-owned checkpoints. Never installed over the stable mod until QA passes.
+namespace GOTHIC_ENGINE {
+    namespace HostSaves {
+        namespace fs=std::filesystem;
+        static std::string redirectedCurrent;
+        static bool nativeIO=false;
+        static int pendingSaveEvent=-1;
+        static bool flushingSaveEvent=false;
+        static bool autoStartPending=false,autoStartSawDialogue=false,autoSaving=false;
+        static DWORD autoStartReadySince=0;
+        static fs::path Ipc() {char path[MAX_PATH]={0};GetEnvironmentVariableA("G2_COOP_CAMPAIGN",path,sizeof path);return fs::path(path);}
+        static bool IsHost() {char host[4]={0};GetEnvironmentVariableA("G2_COOP_CAMPAIGN_HOST",host,sizeof host);return host[0]=='1';}
+        static bool CanConnect() {auto p=Ipc();return p.empty()||IsHost()||fs::exists(p.string()+".ready");}
+        static void Atomic(const fs::path& path,const json& value){auto tmp=path;tmp+=".tmp";{std::ofstream out(tmp,std::ios::binary);out<<value.dump(2);if(!out)throw std::runtime_error("Cannot write save IPC");}if(!MoveFileExW(tmp.c_str(),path.c_str(),MOVEFILE_REPLACE_EXISTING|MOVEFILE_WRITE_THROUGH))throw std::runtime_error("Cannot commit save IPC");}
+        static void Event(const char* event,int slot) {if(!strcmp(event,"save")&&!flushingSaveEvent){pendingSaveEvent=slot;return;}auto p=Ipc();if(p.empty()||!IsHost()||nativeIO)return;if(!strcmp(event,"new")){autoStartPending=true;autoStartSawDialogue=false;autoStartReadySince=0;}else if(!strcmp(event,"load"))autoStartPending=false;if(slot>=0){char exe[MAX_PATH];GetModuleFileNameA(NULL,exe,MAX_PATH);auto dir=fs::path(exe).parent_path().parent_path()/"Saves"/(slot==0?"quicksave":"savegame"+std::to_string(slot));if(!strcmp(event,"save"))SharedGameplay::Save(dir);else if(!strcmp(event,"load"))SharedGameplay::Load(dir);}Atomic(p.string()+".event",{{"event",event},{"slot",slot}});}
+        static LONG CALLBACK TraceException(EXCEPTION_POINTERS* ex) {
+            if(ex->ExceptionRecord->ExceptionCode==EXCEPTION_ACCESS_VIOLATION) {
+                char buffer[256];auto c=ex->ContextRecord;
+                sprintf_s(buffer,"AV eip=%08lX ecx=%08lX eax=%08lX address=%08lX",c->Eip,c->Ecx,c->Eax,(DWORD)ex->ExceptionRecord->ExceptionInformation[1]);
+                char exe[MAX_PATH];GetModuleFileNameA(NULL,exe,MAX_PATH);
+                std::ofstream out(fs::path(exe).parent_path()/"HostSaveException.log",std::ios::app);out<<buffer<<"\n";
+                out<<"plugin="<<PluginState<<"\n";
+                CONTEXT context=*c;STACKFRAME64 frame={};frame.AddrPC={context.Eip,0,AddrModeFlat};frame.AddrFrame={context.Ebp,0,AddrModeFlat};frame.AddrStack={context.Esp,0,AddrModeFlat};
+                for(int i=0;i<24&&StackWalk64(IMAGE_FILE_MACHINE_I386,GetCurrentProcess(),GetCurrentThread(),&frame,&context,nullptr,SymFunctionTableAccess64,SymGetModuleBase64,nullptr);++i){char address[40];sprintf_s(address,"%08llX",frame.AddrPC.Offset);out<<address;char symbols[sizeof(SYMBOL_INFO)+1024]={0};auto info=(SYMBOL_INFO*)symbols;info->SizeOfStruct=sizeof(SYMBOL_INFO);info->MaxNameLen=1023;DWORD64 offset=0;if(SymFromAddr(GetCurrentProcess(),frame.AddrPC.Offset,&offset,info))out<<" "<<info->Name<<"+"<<offset;out<<"\n";}
+            }
+            return EXCEPTION_CONTINUE_SEARCH;
+        }
+        static fs::path SaveRoot() {
+            char exe[MAX_PATH];GetModuleFileNameA(NULL,exe,MAX_PATH);
+            auto game=fs::path(exe).parent_path().parent_path();
+            fs::path configured(zoptions->GetDirString(DIR_SAVEGAMES).ToChar());
+            return configured.is_absolute()?configured:(game/configured.relative_path()).lexically_normal();
+        }
+        static void Log(const std::string& message) {
+            char exe[MAX_PATH];GetModuleFileNameA(NULL,exe,MAX_PATH);
+            fs::path path=fs::path(exe).parent_path()/"HostSave.log";
+            std::ofstream out(path,std::ios::app);out<<GetTickCount()<<" "<<message<<"\n";
+        }
+        static CInvoke<zSTRING(oCSavegameManager::*)(int)> OriginalSlotDir(0x004397B0,&oCSavegameManager::GetSlotDirName_HostSave);
+        static CInvoke<zSTRING(oCSavegameInfo::*)()> OriginalInfoDir(0x00437310,&oCSavegameInfo::GetDir_HostSave);
+        static CInvoke<void(oCSavegameManager::*)(int)> OriginalCopyToCurrent(0x00439310,&oCSavegameManager::CopyToCurrent_HostSave);
+        static CInvoke<void(CGameManager::*)(int)> OriginalWrite(0x0042A2D0,&CGameManager::Write_Savegame_HostOnly);
+        static CInvoke<void(CGameManager::*)(int)> OriginalRead(0x0042A040,&CGameManager::Read_Savegame_HostOnly);
+        struct Redirect {
+            char cwd[MAX_PATH];
+            Redirect(const fs::path& directory) {
+                GetCurrentDirectoryA(MAX_PATH,cwd);
+                redirectedCurrent=directory.filename().string()+"\\";nativeIO=true;
+            }
+            ~Redirect(){nativeIO=false;redirectedCurrent.clear();SetCurrentDirectoryA(cwd);}
+        };
+        static fs::path Capture() {
+            auto root=SaveRoot();
+            auto target=root/("coop-capture-"+std::to_string(GetTickCount()));
+            fs::create_directories(target);
+            auto current=root/"current";
+            if(fs::exists(current))for(auto& item:fs::directory_iterator(current)) {
+                if(item.is_regular_file())fs::copy_file(item.path(),target/item.path().filename());
+            }
+            Log("capture begin: "+target.string());
+            {
+                Redirect guard(target);
+                ogame->WriteSavegame(-1,1);
+            }
+            SharedGameplay::Save(target);
+            size_t bytes=0,files=0;
+            for(auto& item:fs::directory_iterator(target))if(item.is_regular_file()){bytes+=item.file_size();++files;}
+            Log("capture complete: files="+std::to_string(files)+" bytes="+std::to_string(bytes));
+            if(!files || !bytes)throw std::runtime_error("Engine produced an empty snapshot");
+            return target;
+        }
+        static fs::path Restore(const fs::path& directory) {
+            if(ServerThread || ClientThread)throw std::runtime_error("Restore must finish before game networking starts");
+            auto& information=oCInformationManager::GetInformationManager();
+            if(!information.HasFinished()||information.WaitingForEnd())throw std::runtime_error("Wait until the dialogue has fully finished before restoring");
+            if(!fs::equivalent(directory.parent_path(),SaveRoot()))throw std::runtime_error("Restore directory outside isolated save root");
+            Log("restore begin: "+directory.string());
+            LoadBegin();
+            gameMan->exitSession=0;
+            ogame->SetGameInfo(nullptr);
+            {
+                Redirect guard(directory);
+                auto manager=gameMan->savegameManager;
+                auto original=manager->localInfo;
+                auto temporary=original?nullptr:new oCSavegameInfo(-1);
+                if(temporary){manager->localInfo=temporary;Log("created temporary current-slot metadata");}
+                ogame->LoadSavegame(-1,1);
+                if(temporary){manager->localInfo=original;temporary->Release();}
+            }
+            // Later level transitions read the normal current directory. Preserve its old
+            // contents, then seed it from this checkpoint's visited-world archives.
+            auto current=SaveRoot()/"current";
+            fs::path backup;
+            if(fs::exists(current)){backup=SaveRoot()/("coop-before-restore-"+std::to_string(GetTickCount()));fs::rename(current,backup);}
+            fs::create_directories(current);
+            for(auto& item:fs::directory_iterator(directory))if(item.is_regular_file())fs::copy_file(item.path(),current/item.path().filename());
+            Game_LoadEnd_SaveGame();
+            SharedGameplay::Load(directory);
+            Log("restore complete");
+            return backup;
+        }
+        static json HeroState() {
+            int chapter=0;auto symbol=parser->GetSymbol("KAPITEL");if(symbol)symbol->GetValue(chapter,0);
+            auto gold=player->IsInInv(zSTRING("ITMI_GOLD"),1);
+            return {{"strength",player->attribute[NPC_ATR_STRENGTH]},
+                {"learn_points",player->learn_points},{"gold",gold?gold->amount:0},{"chapter",chapter}};
+        }
+        static void QaReport(const json& data) {
+            char exe[MAX_PATH];GetModuleFileNameA(NULL,exe,MAX_PATH);
+            std::ofstream out(fs::path(exe).parent_path()/"HostSaveQA.json");out<<data.dump(2);
+        }
+        static void Tick() {
+            static auto handler=AddVectoredExceptionHandler(1,TraceException);
+            if(autoSaving)return;
+            if(pendingSaveEvent>=0&&!IsSavingGame&&!nativeIO){int slot=pendingSaveEvent;pendingSaveEvent=-1;flushingSaveEvent=true;Event("save",slot);flushingSaveEvent=false;}
+            auto ipc=Ipc();
+            if(autoStartPending&&IsHost()&&!nativeIO&&!IsLoadingLevel&&player&&ogame->GetWorld()) {
+                auto& info=oCInformationManager::GetInformationManager();
+                auto xardas=parser->GetIndex("NONE_100_XARDAS");
+                if(xardas>=0&&info.Npc&&info.Npc->GetInstance()==xardas)autoStartSawDialogue=true;
+                bool finished=autoStartSawDialogue&&info.HasFinished()&&!info.WaitingForEnd()&&!IsPlayerTalkingWithAnybody()&&!IsSavingGame&&SharedGameplay::CanSave();
+                if(!finished)autoStartReadySince=0;
+                else if(!autoStartReadySince)autoStartReadySince=GetTickCount();
+                else if(GetTickCount()-autoStartReadySince>=2000) {
+                    autoStartPending=false;int slot=-1;
+                    for(int i=20;i>=1;--i){auto info=gameMan->savegameManager->GetSavegame(i);if(info&&info->m_SlotNr==i&&!info->DoesSavegameExist()&&!fs::exists(SaveRoot()/("savegame"+std::to_string(i)))){slot=i;break;}}
+                    if(slot<0)ChatLog("Host saves: no free slot for the starting checkpoint. Save manually.");
+                    else {
+                        struct SavingGuard {SavingGuard(){autoSaving=true;}~SavingGuard(){autoSaving=false;}} guard;
+                        gameMan->savegameManager->GetSavegame(slot)->m_Name=zSTRING("Co-op: after Xardas");
+                        gameMan->Write_Savegame(slot);Event("save",slot);
+                        ChatLog(("Host saves: starting checkpoint written to slot "+std::to_string(slot)+".").c_str());
+                    }
+                }
+            }
+            // Only the automated test role skips the introduction conversation.
+            if(QaRole("checkpoint")&&!autoStartSawDialogue&&!ipc.empty()&&fs::exists(ipc.string()+".command"))return;
+            if((QaRole("client")||QaRole("checkpoint"))&&!ipc.empty()&&player&&!IsLoadingLevel&&fs::exists(ipc.string()+".command")) {
+                auto& info=oCInformationManager::GetInformationManager();
+                if(IsPlayerTalkingWithAnybody()||!info.HasFinished()||info.WaitingForEnd()){info.Exit();info.OnTermination();return;}
+            }
+            if(!ipc.empty()&&player&&!IsLoadingLevel) {
+                static DWORD nextStatus=0;static std::string previous;
+                if((LONG)(GetTickCount()-nextStatus)>=0) {
+                    nextStatus=GetTickCount()+500;
+                    try {auto path=fs::path(ipc.string()+".status");if(fs::exists(path)){json state;std::ifstream in(path);in>>state;auto message=state.value("state","")+": "+state.value("detail","");if(message!=previous){previous=message;ChatLog(("Host saves: "+message).c_str());}}}catch(const std::exception&){}
+                }
+            }
+            if(!ipc.empty()&&!nativeIO&&!IsLoadingLevel&&player&&ogame->GetWorld()&&!IsPlayerTalkingWithAnybody()&&oCInformationManager::GetInformationManager().HasFinished()&&!oCInformationManager::GetInformationManager().WaitingForEnd()) {
+                auto command=fs::path(ipc.string()+".command");
+                if(fs::exists(command)) {
+                    json reply;
+                    try {
+                        json request;{std::ifstream in(command);in>>request;}fs::remove(command);
+                        reply={{"op",request.at("op")},{"id",request.at("id")},{"ok",true}};
+                        if(request.at("op")=="capture"){reply["path"]=Capture().u8string();reply["hero"]=HeroState();}
+                        else if(request.at("op")=="restore"){auto backup=Restore(fs::u8path(request.at("path").get<std::string>()));reply["hero"]=HeroState();reply["previous_cache"]=backup.u8string();}
+                        else if(request.at("op")=="qa-save-local"&&QaRole("client")){gameMan->Write_Savegame(request.at("slot"));}
+                        else if(request.at("op")=="qa-load-local"&&QaRole("client")){gameMan->Read_Savegame(request.at("slot"));reply["hero"]=HeroState();}
+                        else if(request.at("op")=="qa-set"&&QaRole("client")){
+                            player->attribute[NPC_ATR_STRENGTH]=73;player->learn_points=19;
+                            auto gold=player->IsInInv(zSTRING("ITMI_GOLD"),1);if(gold)player->RemoveFromInv(gold,gold->amount);
+                            player->CreateItems(parser->GetIndex("ITMI_GOLD"),137);
+                            auto chapter=parser->GetSymbol("KAPITEL");if(chapter)chapter->SetValue(3,0);
+                            reply["hero"]=HeroState();
+                        }
+                        else if(request.at("op")=="qa-finish"&&QaRole("checkpoint")){reply["hero"]=HeroState();}
+                        else throw std::runtime_error("Unknown native save command");
+                    }catch(const std::exception& e){reply["ok"]=false;reply["error"]=e.what();Log(e.what());}
+                    Atomic(ipc.string()+".reply",reply);
+                }
+            }
+            if(nativeIO || !QaRole("save") || IsLoadingLevel || !player || !ogame->GetWorld())return;
+            static int stage=0;
+            static DWORD first=GetTickCount();
+            static fs::path snapshot;
+            static json expected;
+            try {
+                if(stage==0) {
+                    static bool logging=false;if(!logging){logging=true;zerr->SetTarget(zERR_TARGET_FILE);zerr->SetFilterLevel(9);}
+                    if(GetTickCount()-first<5000)return;
+                    auto& info=oCInformationManager::GetInformationManager();
+                    if(IsPlayerTalkingWithAnybody()||!info.HasFinished()||info.WaitingForEnd()){info.Exit();info.OnTermination();return;}
+                    player->attribute[NPC_ATR_STRENGTH]=73;player->learn_points=19;
+                    auto gold=player->IsInInv(zSTRING("ITMI_GOLD"),1);
+                    if(gold)player->RemoveFromInv(gold,gold->amount);
+                    player->CreateItems(parser->GetIndex("ITMI_GOLD"),137);
+                    auto chapter=parser->GetSymbol("KAPITEL");if(chapter)chapter->SetValue(3,0);
+                    expected=HeroState();snapshot=Capture();stage=1;
+                    QaReport({{"status","captured"},{"expected",expected},{"path",snapshot.string()}});
+                } else if(stage==1) {
+                    player->attribute[NPC_ATR_STRENGTH]=12;player->learn_points=1;
+                    auto chapter=parser->GetSymbol("KAPITEL");if(chapter)chapter->SetValue(1,0);
+                    auto gold=player->IsInInv(zSTRING("ITMI_GOLD"),1);if(gold)player->RemoveFromInv(gold,gold->amount);
+                    stage=2;Restore(snapshot);
+                } else if(stage==2) {
+                    static DWORD verifyStart=GetTickCount();auto actual=HeroState();
+                    if(actual!=expected){stage=3;QaReport({{"status","failed"},{"expected",expected},{"actual",actual}});}
+                    else if(GetTickCount()-verifyStart>=10000){stage=3;QaReport({{"status","passed"},{"expected",expected},{"actual",actual},{"path",snapshot.string()},{"stable_ms",GetTickCount()-verifyStart}});}
+                    else QaReport({{"status","verifying"},{"expected",expected},{"actual",actual}});
+                }
+            } catch(const std::exception& error) {stage=3;Log(error.what());QaReport({{"status","failed"},{"error",error.what()}});}
+        }
+    }
+    zSTRING oCSavegameManager::GetSlotDirName_HostSave(int slot) {
+        if(HostSaves::nativeIO && slot==-1)return zSTRING(HostSaves::redirectedCurrent.c_str());
+        auto original=HostSaves::OriginalSlotDir.ReinterpretTo();
+        return (this->*original)(slot);
+    }
+    zSTRING oCSavegameInfo::GetDir_HostSave() {
+        if(HostSaves::nativeIO && m_SlotNr==-1)return zSTRING(HostSaves::redirectedCurrent.c_str());
+        auto original=HostSaves::OriginalInfoDir.ReinterpretTo();
+        return (this->*original)();
+    }
+    void oCSavegameManager::CopyToCurrent_HostSave(int slot) {
+        if(HostSaves::nativeIO && slot==-1){zoptions->ChangeDir(DIR_SAVEGAMES);HostSaves::Log("private snapshot already current; selected save directory without slot-array copy");return;}
+        auto original=HostSaves::OriginalCopyToCurrent.ReinterpretTo();
+        (this->*original)(slot);
+    }
+    void CGameManager::Write_Savegame_HostOnly(int slot) {
+        if(!SharedGameplay::CanSave()){ChatLog("Finish the active party dialogue before saving.");return;}
+        if(!HostSaves::Ipc().empty()&&!HostSaves::IsHost()){
+            ChatLog("Only the host can save this campaign.");HostSaves::Log("Blocked client manual save: "+std::to_string(slot));return;
+        }
+        auto original=HostSaves::OriginalWrite.ReinterpretTo();(this->*original)(slot);
+    }
+    void CGameManager::Read_Savegame_HostOnly(int slot) {
+        if(!HostSaves::Ipc().empty()&&HostSaves::IsHost()&&(ServerThread||ClientThread)){
+            ChatLog("Restart the co-op session before loading another host checkpoint.");return;
+        }
+        if(!HostSaves::Ipc().empty()&&!HostSaves::IsHost()&&ClientThread){
+            ChatLog("Only the host can load campaign progress. Rejoin to restore your character.");HostSaves::Log("Blocked client manual load: "+std::to_string(slot));return;
+        }
+        auto original=HostSaves::OriginalRead.ReinterpretTo();(this->*original)(slot);
+    }
+}
